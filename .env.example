APP_CONFIG_FILE=configs/config.yaml
APP_NAME=ProjectLens
APP_ENV=development
APP_VERSION=0.1.0
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
LOG_FORMAT=text
# Comma-separated origins, or * to allow any origin.
CORS_ALLOWED_ORIGINS=

DATABASE_URL=postgres://projectlens:projectlens@localhost:5432/projectlens?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s
DB_AUTO_MIGRATE=true

REPO_ALLOWED_LOCAL_ROOTS=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_TIMEOUT=10s
GITHUB_USER_AGENT=ProjectLens

# Job worker
WORKER_MODE=embedded
WORKER_ID=
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=500ms
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_DEFAULT_TIMEOUT=5m
WORKER_DEFAULT_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY=2s
WORKER_RETRY_MAX_DELAY=1m
WORKER_SHUTDOWN_TIMEOUT=15s
