APP_CONFIG_FILE=configs/config.yaml
APP_NAME=ProjectLens
APP_ENV=development
APP_VERSION=0.1.0
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_REQUEST_TIMEOUT=8s
SERVER_MAX_HEADER_BYTES=65536
SERVER_MAX_BODY_BYTES=4194304
SERVER_MAX_IN_FLIGHT=128
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s
# Local binary defaults. Compose enables auth and supplies a development token.
AUTH_ENABLED=false
AUTH_BEARER_TOKENS=
# Compose host ports and stop grace periods.
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
API_STOP_GRACE_PERIOD=30s
WORKER_STOP_GRACE_PERIOD=20s
LOG_LEVEL=info
LOG_FORMAT=text
# Comma-separated origins, or * to allow any origin.
CORS_ALLOWED_ORIGINS=

DATABASE_URL=postgres://projectlens:projectlens@localhost:5432/projectlens?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s
DB_AUTO_MIGRATE=true

# Local Git sources feed read-only snapshots. Standalone Markdown edits stay in PostgreSQL.
# With Compose, use docker-compose.local-repos.example.yml for /repos read-only binds.
# Native hosts need a read-only mount or restricted user/ACLs for OS enforcement.
REPO_ALLOWED_LOCAL_ROOTS=
GITHUB_GIT_BASE_URL=
GITHUB_API_BASE_URL=https://api.github.com
# Optional for public GitHub. Use a fine-grained read-only token or zero-scope
# classic PAT. The GitHub API client rejects elevated classic scopes.
GITHUB_TOKEN=
GITHUB_TIMEOUT=10s
GITHUB_USER_AGENT=ProjectLens

# Job worker
WORKER_MODE=embedded
WORKER_ID=
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=500ms
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_DEFAULT_TIMEOUT=5m
WORKER_DEFAULT_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY=2s
WORKER_RETRY_MAX_DELAY=1m
WORKER_SHUTDOWN_TIMEOUT=15s

SCANNER_CACHE_DIR=
SCANNER_GIT_TIMEOUT=2m
SCANNER_MAX_FILE_SIZE=1048576
SCANNER_MAX_TOTAL_BYTES=52428800
SCANNER_MAX_FILES=10000
SCANNER_MAX_PATH_LENGTH=512
SCANNER_MAX_PATH_DEPTH=32
SCANNER_EXCLUDE_PATTERNS=

SYNC_RETAIN_SUPERSEDED=2
SYNC_FAILED_RETENTION=24h

DOCUMENT_MAX_CONTENT_BYTES=1048576

REDIS_ENABLED=true
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=projectlens
REDIS_DIAL_TIMEOUT=300ms
REDIS_READ_TIMEOUT=300ms
REDIS_WRITE_TIMEOUT=300ms
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
SEARCH_MAX_QUERY_LENGTH=200
SEARCH_CACHE_TTL=5m

WORKER_ENABLE_MOCK_JOBS=false
SCHEDULE_MIN_INTERVAL_SECONDS=60
SCHEDULE_BATCH=4
METRICS_ADDR=
TRACE_ENABLED=false
